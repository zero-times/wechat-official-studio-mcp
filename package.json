{
  "name": "wechat-official-studio-mcp-server",
  "version": "0.2.3",
  "private": true,
  "type": "module",
  "description": "Safely read a logged-in WeChat Official Account, upload approved images, and save reviewed drafts.",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.json --noEmit",
    "configure-cookie": "node scripts/configure-cookie.mjs",
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "test": "node --import tsx --test tests/**/*.test.ts",
    "security:scan": "node scripts/check-public-safety.mjs",
    "verify": "npm test && npm run check && npm run build && npm run security:scan"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.24.2",
    "cheerio": "^1.1.2",
    "csv-parse": "^6.1.0",
    "dotenv": "^17.2.3",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=20"
  }
}
