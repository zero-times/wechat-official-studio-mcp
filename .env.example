# Optional. The secure configurator writes the cookie to .wechat-cookie instead.
# WECHAT_OFFICIAL_COOKIE=

# Optional fallback when the token cannot be inferred from the logged-in redirect.
WECHAT_OFFICIAL_TOKEN=

# Request timeout in milliseconds. Write timeouts are treated as ambiguous and are never retried automatically.
WECHAT_OFFICIAL_TIMEOUT_MS=30000

# Optional absolute path for the cookie file.
# WECHAT_OFFICIAL_COOKIE_FILE=/absolute/path/to/.wechat-cookie

# Required for uploads. Use the OS path delimiter for multiple approved directories.
# WECHAT_OFFICIAL_UPLOAD_ROOTS=/absolute/path/to/approved-images
